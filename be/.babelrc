{
  "presets": [
    [
      "@babel/preset-env",
      {
        "targets": {
          "node": "current"
        }
      }
    ],
    "@babel/preset-typescript"
  ],
  "plugins": [
    "@babel/plugin-transform-runtime",
    [
      "module-resolver",
      {
        "alias": {
          "@": "./src"
        },
        "extensions": [".js", ".jsx", ".ts", ".tsx", ".json"]
      }
    ]
  ],
  "ignore": ["./build", "./node_modules"],
  "comments": false,
  "env": {
    "build": {
      "sourceMaps": true
    }
  }
}
